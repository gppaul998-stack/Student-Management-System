#!/usr/bin/env python3

import argparse
import socket
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from typing import Optional


@dataclass
class ScanResult:
    port: int
    state: str
    service: str = ""
    banner: str = ""


def parse_ports(port_spec: str) -> list[int]:
    """
    Parse:
        80
        80,443,8080
        1-1024
        22,80,443,8000-8100
    """
    ports = set()

    for item in port_spec.split(","):
        item = item.strip()

        if not item:
            continue

        if "-" in item:
            parts = item.split("-", 1)

            if len(parts) != 2:
                raise ValueError(f"Invalid port range: {item}")

            start = int(parts[0])
            end = int(parts[1])

            if start > end:
                start, end = end, start

            ports.update(range(start, end + 1))
        else:
            ports.add(int(item))

    for port in ports:
        if not 1 <= port <= 65535:
            raise ValueError(f"Port out of range: {port}")

    return sorted(ports)


def service_name(port: int) -> str:
    """Return the OS-known service name when available."""
    try:
        return socket.getservbyport(port, "tcp")
    except OSError:
        return ""


def grab_banner(
    sock: socket.socket,
    timeout: float,
    port: int,
) -> str:
    """
    Attempt a small passive banner read.

    This intentionally does not send protocol-specific probes.
    """
    try:
        sock.settimeout(timeout)
        data = sock.recv(256)

        if not data:
            return ""

        return data.decode("utf-8", errors="replace").strip()

    except (socket.timeout, ConnectionResetError, OSError):
        return ""


def scan_port(
    host: str,
    port: int,
    timeout: float,
    banner: bool,
) -> ScanResult:

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(timeout)

    try:
        result = sock.connect_ex((host, port))

        if result == 0:
            service = service_name(port)
            banner_text = ""

            if banner:
                banner_text = grab_banner(sock, timeout, port)

            return ScanResult(
                port=port,
                state="OPEN",
                service=service,
                banner=banner_text,
            )

        return ScanResult(
            port=port,
            state="CLOSED",
            service=service_name(port),
        )

    except socket.timeout:
        return ScanResult(
            port=port,
            state="TIMEOUT",
            service=service_name(port),
        )

    except OSError as exc:
        return ScanResult(
            port=port,
            state=f"ERROR ({exc})",
            service=service_name(port),
        )

    finally:
        sock.close()


def resolve_host(host: str) -> str:
    """Resolve hostname to an IPv4 address."""
    try:
        return socket.gethostbyname(host)
    except socket.gaierror as exc:
        raise RuntimeError(f"Could not resolve '{host}': {exc}") from exc


def scan_host(
    host: str,
    ports: list[int],
    timeout: float,
    workers: int,
    banner: bool,
) -> list[ScanResult]:

    results = []

    print(f"\nScanning {host}")
    print("-" * 60)

    with ThreadPoolExecutor(max_workers=workers) as executor:
        futures = {
            executor.submit(
                scan_port,
                host,
                port,
                timeout,
                banner,
            ): port
            for port in ports
        }

        for future in as_completed(futures):
            result = future.result()
            results.append(result)

            # Only print open ports during the scan.
            if result.state == "OPEN":
                service = f" ({result.service})" if result.service else ""

                print(
                    f"{result.port:5d}/tcp  "
                    f"{result.state:<8}"
                    f"{service}"
                )

                if result.banner:
                    print(f"             Banner: {result.banner}")

    return sorted(results, key=lambda x: x.port)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Simple TCP connect port scanner"
    )

    parser.add_argument(
        "host",
        help="Hostname or IPv4 address to scan",
    )

    parser.add_argument(
        "-p",
        "--ports",
        default="1-1024",
        help=(
            "Ports to scan. Examples: "
            "80,443 or 1-1024 or 22,80,443,8000-8100. "
            "Default: 1-1024"
        ),
    )

    parser.add_argument(
        "-t",
        "--timeout",
        type=float,
        default=1.0,
        help="Connection timeout in seconds. Default: 1.0",
    )

    parser.add_argument(
        "-w",
        "--workers",
        type=int,
        default=100,
        help="Maximum concurrent connections. Default: 100",
    )

    parser.add_argument(
        "-b",
        "--banner",
        action="store_true",
        help="Attempt basic passive banner grabbing",
    )

    parser.add_argument(
        "--show-all",
        action="store_true",
        help="Display closed and timed-out ports too",
    )

    args = parser.parse_args()

    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")

    if args.workers <= 0:
        parser.error("--workers must be greater than zero")

    if args.workers > 500:
        parser.error("--workers cannot exceed 500")

    try:
        ports = parse_ports(args.ports)
    except ValueError as exc:
        parser.error(str(exc))

    if not ports:
        parser.error("No ports specified")

    try:
        ip = resolve_host(args.host)
    except RuntimeError as exc:
        parser.error(str(exc))

    print("TCP Connect Scanner")
    print("===================")
    print(f"Target : {args.host}")
    print(f"Address: {ip}")
    print(f"Ports  : {len(ports)}")
    print(f"Timeout: {args.timeout}s")
    print(f"Workers: {args.workers}")

    results = scan_host(
        ip,
        ports,
        args.timeout,
        args.workers,
        args.banner,
    )

    if args.show_all:
        print("\nComplete Results")
        print("-" * 60)

        for result in results:
            service = (
                f" ({result.service})"
                if result.service
                else ""
            )

            print(
                f"{result.port:5d}/tcp  "
                f"{result.state:<10}"
                f"{service}"
            )

    open_ports = [
        result
        for result in results
        if result.state == "OPEN"
    ]

    print("\nSummary")
    print("-" * 60)
    print(f"Scanned : {len(results)} ports")
    print(f"Open    : {len(open_ports)}")

    if open_ports:
        print("\nOpen ports:")
        for result in open_ports:
            service = result.service or "unknown"
            print(f"  {result.port}/tcp  {service}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
